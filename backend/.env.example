# Used when running the backend outside Docker (`npm run dev`).
# Assumes Postgres from docker-compose is published on localhost:5432.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://lms_app:lms_app_dev_password@localhost:5432/lms
DIRECT_DATABASE_URL=postgresql://lms_owner:lms_owner_dev_password@localhost:5432/lms

ML_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=change-me-internal-token

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

CORS_ORIGIN=http://localhost:5173
