# Root env consumed by docker-compose.yml. Copy to `.env` and change the secrets.
# Every value has a dev default in docker-compose.yml, so `.env` is optional locally.

# --- Postgres ---
# Owner/superuser role: runs migrations, owns tables. RLS does NOT apply to it.
POSTGRES_USER=lms_owner
POSTGRES_PASSWORD=lms_owner_dev_password
POSTGRES_DB=lms
POSTGRES_PORT=5432
# Runtime role used by the backend. NOBYPASSRLS, so tenant policies always apply.
APP_DB_USER=lms_app
APP_DB_PASSWORD=lms_app_dev_password

# --- Backend ---
BACKEND_PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# --- Service-to-service ---
# Shared secret the backend sends to ml-service in the X-Internal-Token header.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# --- Ports ---
ML_SERVICE_PORT=8000
FRONTEND_PORT=5173
